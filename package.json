{
  "name": "astro-ts-tw-svelte",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "unset:git-hooks-path": "git config --unset core.hooksPath",
    "simple-git-hooks": "npx simple-git-hooks",
    "postinstall": "is-ci || npm run simple-git-hooks",
    "prettier": "prettier --write  \"**/*.{js,jsx,ts,tsx,md,mdx,astro,svelte}\"",
    "eslint": "eslint --fix \"src/**/*.{js,ts,jsx,tsx,astro,svelte}\"",
    "astro:check": "astro check",
    "astro:build": "astro build",
    "check": "run-s astro:check prettier eslint",
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "run-s check astro:build",
    "preview": "astro preview --host",
    "sync": "astro sync",
    "astro": "astro",
    "gh-pages-build": "cross-env GITHUB_PAGES=true npm run build",
    "gh-pages-preview": "cross-env GITHUB_PAGES=true GITHUB_PAGES_PREVIEW=true npm run preview"
  },
  "dependencies": {
    "astro": "7.3.6",
    "canvas-confetti": "1.9.4",
    "dayjs": "1.11.23",
    "echarts": "6.1.0",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "8.0.3",
    "@astrojs/svelte": "9.0.1",
    "@astrojs/ts-plugin": "1.10.12",
    "@emnapi/runtime": "1.11.3",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "autoprefixer": "10.6.1",
    "clsx": "2.1.1",
    "cross-env": "10.1.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "is-ci": "4.1.0",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.3",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "simple-git-hooks": "2.14.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,md,mdx,astro,svelte}": "prettier --write",
    "src/**/*.{js,ts,jsx,tsx,astro,svelte}": "eslint --fix"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "github_pages": "https://erkobridee.github.io",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "simple-git-hooks@2.14.0": true
  }
}
